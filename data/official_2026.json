  "rules": [
    {"id": "r-definition", "topic": "개념", "rule": "학교 내외에서 학생 대상 상해·폭행·감금·협박·약취유인·명예훼손·모욕·공갈·강요·성폭력·따돌림·사이버폭력 등으로 신체·정신·재산상 피해를 수반하는 행위(유형은 예시적 열거)", "ref": "법 제2조 / p.6-8"},
    {"id": "r-grade-year", "topic": "개념", "rule": "학년도는 3.1~다음 해 2월 말. 유예(휴학·유급) 학생도 학생 신분 유지되어 사안처리 절차 적용", "ref": "p.6"},
    {"id": "r-childabuse", "topic": "예외", "rule": "아동학대로 신고·접수된 사안은 학교폭력 사안처리 적용을 제외할 수 있음(관계기관 협조·지속 보호 의무는 유지)", "ref": "법 제5조 / p.9"},
    {"id": "r-nonstudent", "topic": "예외", "rule": "가해자가 학생이 아닌 사안은 자체해결 대상이 아니며 원칙적으로 심의위 개최 요청. 피해측이 보호조치를 원하지 않으면 미개최 가능(양식3-7 동의·교육청 보고)", "ref": "p.9,47,74"},
    {"id": "r-report-duty", "topic": "신고", "rule": "현장을 보거나 사실을 알게 된 자는 즉시 신고(법 제20조①), 교원은 학교장 보고 + 해당 학부모 통지(법 제20조④)", "ref": "p.20,23-24"},
    {"id": "r-no-retaliation", "topic": "신고", "rule": "신고자 불이익 금지(법 제20조⑤), 비밀누설 금지(법 제21조) 위반 시 1년 이하 징역 또는 1천만원 이하 벌금", "ref": "p.23,93"},
    {"id": "r-secret-range", "topic": "신고", "rule": "비밀 범위: 성명·주민등록번호·주소 등 개인정보, 개인별 발언 내용, 누설 시 분쟁 우려가 명백한 사항", "ref": "시행령 제33조 / p.23"},
    {"id": "r-register", "topic": "접수", "rule": "접수 즉시 신고접수대장 기록. 접수대장은 학교장·교원의 은폐 여부 판단 기초자료이므로 사소한 폭력도 접수", "ref": "p.24,37"},
    {"id": "r-sex-crime", "topic": "성폭력", "rule": "아동·청소년 대상 성범죄를 인지한 때에는 피해측 의사와 무관하게 즉시 수사기관(112·117) 신고. SPO 상담은 신고로 볼 수 없음", "ref": "p.16,33,37"},
    {"id": "r-sex-anon", "topic": "성폭력", "rule": "성폭력 사안은 익명으로 신고 가능", "ref": "p.24"},
    {"id": "r-organization", "topic": "전담기구", "rule": "교감·전문상담교사·보건교사·책임교사·학부모로 구성, 학부모는 1/3 이상(학교운영위원회 추천·학교장 위촉)", "ref": "법 제14조③, 시행령 제16조 / p.35-36"},
    {"id": "r-organization-quorum", "topic": "전담기구", "rule": "심의는 구성원 과반수 참석·과반수 찬성, 비공개 원칙. 전담기구는 회의록 작성 의무 없음", "ref": "p.37"},
    {"id": "r-organization-role", "topic": "전담기구", "rule": "자체해결 부의 여부·학교장 긴급조치 여부·집행정지에 따른 분리·졸업 전 조치 삭제를 심의", "ref": "p.37-38"},
    {"id": "r-investigator", "topic": "전담조사관", "rule": "교육감·교육장이 임명·위촉, 임기 1년. 학교는 확인서 원본 관리·사본 제공, 보안 유의, 자료 관리 대장(양식2-7) 작성", "ref": "p.39-42"},
    {"id": "r-not-case", "topic": "사안아님", "rule": "조사 결과 학교폭력이 아니면 전담기구 회의 확인 후 교육청 보고(양식3-6). 피해측이 심의위 개최를 요청하면 반드시 개최하며, 심의위가 '학교폭력 아님' 결정 시 '조치없음' 처리", "ref": "p.47"},
    {"id": "r-separation-ground", "topic": "분리", "rule": "학교장은 사안 인지 시 특별한 사정이 없으면 지체 없이 가해자(교사 포함)와 피해학생을 분리", "ref": "법 제16조① / p.52"},
    {"id": "r-separation-exception", "topic": "분리", "rule": "분리 예외 4가지: ① 피해학생 반대 의사 ② 가해자·피해학생이 교육활동 중이 아님 ③ 자체해결 4요건 모두 충족하는 경미 사안 ④ 긴급조치로 이미 분리", "ref": "시행령 제17조의2 / p.52-53"},
    {"id": "r-separation-residual", "topic": "분리", "rule": "분리기간 내 4요건 중 하나라도 미충족 사실이 확인되면 잔여 기간 내에서 학교장이 일수를 정해 분리 가능", "ref": "p.53"},
    {"id": "r-separation-method", "topic": "분리", "rule": "분리 대상·기간·공간은 전담기구·소속교원 협의로 학교장이 결정(협의 없이 결정 가능), 학급교체가 아니므로 다른 반 이동 불가, 별도 공간+학습권 보장", "ref": "p.53-54"},
    {"id": "r-separation-count", "topic": "분리", "rule": "동일 피해·가해자 조합은 최초 1회만 분리(새 사안은 추가 가능). 피해학생 1명이 다수를 신고한 경우 피해학생을 분리해 보호 가능", "ref": "p.55"},
    {"id": "r-separation-stay", "topic": "분리", "rule": "집행정지 인용 시 피해측 요청 → 전담기구 심의 → 집행정지 기간 분리. 단 별도 공간 분리는 하지 않음(자리배치·동선 분리)", "ref": "법 제17조의4③ / p.55"},
    {"id": "r-emergency-table", "topic": "긴급조치", "rule": "제17조④(인지 시 제2호, 추인 불요) / ⑤(긴급 시 1·3·5·6·7호, 보고·추인) / ⑥(피해측 요청 시 전담기구 심의 후 6·7호, 보고·추인)", "ref": "p.56-58"},
    {"id": "r-contact-scope", "topic": "긴급조치", "rule": "2호 '접촉' 금지는 의도적 접촉(정보통신망 포함)이며 의도하지 않은 접촉까지 금지하는 것은 아님. 공간적 분리를 의미하지 않음", "ref": "p.57,113"},
    {"id": "r-attendance", "topic": "긴급조치", "rule": "5·6항 제6호 출석정지는 미인정결석, 제7호 학급교체 학적변동은 추인 후 반영(해당 학년도까지 유효)", "ref": "p.58"},
    {"id": "r-selfresolution-4", "topic": "자체해결", "rule": "4요건 모두 충족 + 피해학생·보호자가 심의위 개최를 원하지 않을 것: ① 2주 이상 치료 필요 진단서 미발급 ② 재산상 피해 없음/즉각 복구·복구 약속 ③ 비지속 ④ 보복행위 아님", "ref": "법 제13조의2① / p.73-74"},
    {"id": "r-selfresolution-timing", "topic": "자체해결", "rule": "요건 판단 시점은 전담기구 심의일 이전. 진단서 제출 후 회수하면 미충족. 재산상 피해에는 치료비 포함", "ref": "p.73-74"},
    {"id": "r-selfresolution-procedure", "topic": "자체해결", "rule": "조사(강요 금지) → 서면 동의(양식3-2) → 전담기구 심의(양식3-1) → 학교장 결재 → 교육청 보고(양식3-3) → 보호자 통보", "ref": "p.75"},
    {"id": "r-selfresolution-multi", "topic": "자체해결", "rule": "피해 1명·가해 다수 → 모든 가해학생에 대한 동의 필요. 피해 다수 → 피해학생별로 판단", "ref": "p.75"},
    {"id": "r-selfresolution-cancel", "topic": "자체해결", "rule": "요건 충족이나 피해측 부동의로 심의위 요청된 경우, 의결 전 서면 취소 의사 표명 시 학교장이 요청 취소 가능(자체해결 간주)", "ref": "p.75"},
    {"id": "r-selfresolution-exception", "topic": "자체해결", "rule": "자체해결 후 심의위 요청은 원칙 불가, 예외 2가지(복구 약속 불이행 / 조사에서 확인되지 않은 사실 추가 확인)", "ref": "p.74"},
    {"id": "r-multischool", "topic": "자체해결", "rule": "소속 학교가 다르면 자체해결 여부는 피해학생 소속 학교 전담기구가 심의·학교장이 결정, 가해학생 소속 학교는 그 결정에 따라 심의", "ref": "p.76"},
    {"id": "r-restorative", "topic": "관계회복", "rule": "양측 학생 동의 시에만 진행, 한 측이 중단 의사를 밝히면 중단. 사안처리 전 과정에서 운영 가능", "ref": "p.46,80"},
    {"id": "r-dispute", "topic": "분쟁조정", "rule": "분쟁당사자 신청(양식5-1), 5일 이내 개시, 조정기간 1개월 초과 불가. 고소·고발·민사소송 제기 시 거부·중지 가능", "ref": "법 제18조, 시행령 제27조 / p.83-87"},
    {"id": "r-committee", "topic": "심의위", "rule": "교육지원청 설치, 10~50명, 1/3 이상 학부모. 회의록 작성·보존, 비공개 원칙(회의록 열람·복사는 개인정보 제외 공개)", "ref": "법 제12조·제13조 / p.92-93"},
    {"id": "r-committee-opinion", "topic": "심의위", "rule": "피해측 의사 확인 후 요청이 있으면 전문가 의견 청취 필수", "ref": "법 제13조⑤ / p.93"},
    {"id": "r-defer", "topic": "심의위", "rule": "사안이 복잡하거나 다교 관련·감염병 등으로 조치결정 유보 가능, 유보 사실·사유 서면 통보 후 재개최", "ref": "p.102"},
    {"id": "r-victim-measures", "topic": "피해조치", "rule": "1 심리상담·조언 / 2 일시보호 / 3 치료·요양 / 4 학급교체 / 5 삭제 / 6 그 밖의 보호조치", "ref": "법 제16조① / p.103,107"},
    {"id": "r-victim-cost", "topic": "피해조치", "rule": "1~3호 상담·치료비는 가해학생 보호자 부담. 공제회·교육청 선지급 후 상환청구 가능", "ref": "법 제16조⑥ / p.106"},
    {"id": "r-victim-support", "topic": "피해조치", "rule": "지원 범위: 심리상담 2년(1년 연장 가능), 일시보호 30일, 치료·요양 2년(1년 연장 가능)", "ref": "시행령 제18조 / p.106"},
    {"id": "r-perp-measures", "topic": "가해조치", "rule": "1 서면사과 2 접촉·협박·보복 금지 3 학교봉사 4 사회봉사 5 특별교육·심리치료 6 출석정지 7 학급교체 8 전학 9 퇴학(의무교육과정 불가)", "ref": "법 제17조① / p.110"},
    {"id": "r-retaliation-aggravate", "topic": "가해조치", "rule": "협박·보복 목적 사안은 6~9호 동시 부과 또는 가중 가능", "ref": "법 제17조② / p.110"},
    {"id": "r-linked-edu", "topic": "가해조치", "rule": "2~4호·6~8호 조치 시 특별교육 이수 또는 심리치료 필수, 보호자 동반 교육(피해학생이 장애학생이면 장애인식개선 포함)", "ref": "법 제17조③·⑬ / p.117"},
    {"id": "r-score-band", "topic": "가해조치", "rule": "판정점수 1~3→1호, 4~6→3호, 7~9→4호, 10~12→6호, 13~15→7호, 16~20→8·9호. 2호·5호는 심의위 필요 판단 시. 출석위원 과반수 찬성으로 가중·경감", "ref": "고시 별표 / p.213-214"},
    {"id": "r-transfer", "topic": "가해조치", "rule": "전학 후 피해학생 소속 학교로 재전학 불가. 상급학교 배정 시 분리 배정, 피해학생 우선", "ref": "시행령 제20조 / p.111,114"},
    {"id": "r-article2-breach", "topic": "가해조치", "rule": "2호 조치 위반은 새로운 학교폭력 사안으로 접수해 사안처리", "ref": "p.115"},
    {"id": "r-parent-edu", "topic": "가해조치", "rule": "보호자 특별교육: 2호·3호 4시간 이내, 4~7호 5시간 이상. 불응 시 300만원 이하 과태료", "ref": "법 제23조 / p.119-120"},
    {"id": "r-record-write", "topic": "생기부", "rule": "조치결정 통보 공문 접수 즉시 '학교폭력 조치상황 관리'란에 기재(2024.3.1부터 일원화). 소송 중에도 삭제하지 않고 조치사항만 수정, 결정일자는 변경하지 않음", "ref": "p.122"},
    {"id": "r-record-nonwrite", "topic": "생기부", "rule": "제17조④ 긴급조치(2호)와 특별교육 이수 사실은 기재하지 않음", "ref": "p.122"},
    {"id": "r-record-hold", "topic": "생기부", "rule": "1~3호 조건부 기재유보: 미이행 시 또는 동일 학교급 재학 중(초등은 3년 내) 다른 사안으로 같은 조치를 받은 경우에만 기재. 집행정지 인용 시 기재 보류", "ref": "p.121,123"},
    {"id": "r-record-delete", "topic": "생기부", "rule": "삭제(2024.3.1 이후 신고): 1·2·3호 졸업과 동시 / 4·5호 졸업일부터 2년 / 6·7호 졸업일부터 4년(졸업 직전 심의로 즉시 삭제 가능) / 8호 4년(심의 불가) / 9호 삭제 대상 아님", "ref": "p.124-127"},
    {"id": "r-record-review", "topic": "생기부", "rule": "졸업 직전 삭제 심의 요건: 재학 중 서로 다른 사안 2건 이상 조치 사실 없음 + 결정일부터 졸업학년도 2월 말까지 6개월 경과. 확인자료 ①~⑤ 하나라도 미제출 시 삭제 불가, 과반수 찬성 의결", "ref": "p.127,142-144"},
    {"id": "r-record-upper", "topic": "생기부", "rule": "상급학교 진학 후 조치 결정 시 개최 요청을 한 학교급 학생부에 기재, 조치결정일은 졸업학년도 2월 말일", "ref": "p.127-128"},
    {"id": "r-appeal", "topic": "불복", "rule": "피해·가해 학생 또는 보호자가 행정심판 청구(90일/180일). 집행정지 결정 전 피해측 의견청취 필수, 인용 시 피해측 분리 요청권", "ref": "법 제17조의2·제17조의4 / p.129-130"},
    {"id": "r-immunity", "topic": "면책", "rule": "법령·학칙을 준수한 정당한 사안처리·학생생활지도는 민·형사 책임 없음(법 제11조의4③). 법률지원단 상담·법률서비스 제공", "ref": "p.140"},
    {"id": "r-guideline-use", "topic": "운영", "rule": "사안조사는 수업시간 외 원칙, 심의위 의결 전에는 '관련 학생' 용어 사용, 동일 사안 재심 성격의 심의위 개최 금지", "ref": "p.16"}
  ],
